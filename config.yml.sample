---
# image_build_manager standalone configuration
# Copy to config.yml and edit for your environment.
#
# This file replaces OIM metadata + default.yml in standalone mode.
# RPM repos and OS version come from repo_status.yml (separate file).
#
# Paths are auto-derived — no path configuration needed:
#   input  → src/input/<project_name>/
#   output → src/output/<project_name>/
#   repo_manager_output → src/input/<project_name>/repo_manager_output/
#     (copy repo_status.yml + certs/ from your repo_manager host)

project_name: "project_default"

build_host:
  hostname: "localhost"            # For cluster naming (standalone always runs locally)
  shared_path: "/opt/image_build"  # Persistent storage for MinIO + Registry data
  domain_name: "local"
  admin_nic_ip: "10.20.0.1"       # Admin NIC IP — Pulp and S3 endpoint
